SEC_RESEARCH_APP_NAME="SEC Research Desk"
SEC_RESEARCH_DEBUG=false

# Required for SEC requests: replace with your application name and real contact.
# SEC_RESEARCH_SEC_USER_AGENT="SEC Research Desk your-email@example.com"
# SEC_RESEARCH_SEC_CACHE_TTL_SECONDS=3600
# SEC_RESEARCH_SEC_REQUEST_INTERVAL_SECONDS=0.2
# SEC_RESEARCH_SEC_TIMEOUT_SECONDS=30
# SEC_RESEARCH_SEC_MAX_RETRIES=2
# SEC_RESEARCH_SEC_CACHE_DIR=/absolute/path/to/local/sec-cache

# Milestone 3: local filing retrieval (Docker Compose + native Ollama).
# SEC_RESEARCH_DATABASE_URL=postgresql://sec_research:sec_research@127.0.0.1:5432/sec_research
# SEC_RESEARCH_OLLAMA_BASE_URL=http://127.0.0.1:11434
# SEC_RESEARCH_EMBEDDING_MODEL=nomic-embed-text
# SEC_RESEARCH_EMBEDDING_DIMENSIONS=768
# SEC_RESEARCH_EMBEDDING_BATCH_SIZE=16
# SEC_RESEARCH_EMBEDDING_TIMEOUT_SECONDS=120
# SEC_RESEARCH_RAG_CHUNK_SIZE=1800
# SEC_RESEARCH_RAG_CHUNK_OVERLAP=200

